{
  "name": "learning-hub",
  "version": "2.10.0",
  "private": true,
  "description": "把分散在雨课堂、小雅、智慧树、MOOC 等平台上的课程收进一个页面：本地网页应用 + 浏览器扩展 + 事务日历 + 代码学习工作台",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Reese-X08/learning-hub.git"
  },
  "scripts": {
    "start": "node server.js",
    "set-password": "node server.js set-password",
    "test": "node --test tests/updates.test.js tests/self-update.test.js tests/manifest.test.js tests/code-lab.test.js tests/code-lab-profiles.test.js",
    "manifest": "node tools/build-update-manifest.js",
    "manifest:check": "node tools/build-update-manifest.js --check",
    "build": "powershell -ExecutionPolicy Bypass -File tools/build-package.ps1",
    "build:code": "powershell -ExecutionPolicy Bypass -File tools/build-update-package.ps1",
    "build:updater": "powershell -ExecutionPolicy Bypass -File tools/build-updater-package.ps1"
  },
  "engines": {
    "node": ">=18"
  }
}
